# ============================================================
# E-Training API — environment example
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---------- App ----------
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://etraining:etraining@localhost:5432/etraining?schema=public

# ---------- JWT ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-too-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# Active Directory / LDAPS
# ============================================================
# Use ldaps:// for production (port 636).
# For a lab without a DC certificate yet, use ldap:// and port 389.
AD_URL=ldaps://dc01.lab.local:636

# Directory search base (your domain DN)
AD_BASE_DN=DC=lab,DC=local

# Domain NetBIOS / UPN suffix. Accepts DOMAIN\user or user@domain forms.
AD_DOMAIN=lab.local
AD_NETBIOS=LAB

# Read-only service account used ONLY to search the directory.
# Never store end-user AD passwords anywhere.
AD_BIND_DN=CN=svc-etraining,CN=Users,DC=lab,DC=local
AD_BIND_PASSWORD=ChangeMeServiceAccountPassword

# Attribute mapping (standard AD defaults; override if your schema differs)
AD_ATTR_USERNAME=sAMAccountName
AD_ATTR_EMAIL=mail
AD_ATTR_FULLNAME=displayName
AD_ATTR_EMPLOYEE_ID=employeeID
AD_ATTR_DEPARTMENT=department
AD_ATTR_JOB_TITLE=title
AD_ATTR_GROUPS=memberOf
AD_ATTR_ENABLED=userAccountControl

# AD group -> application role mapping
AD_GROUP_ADMIN=Training-Admins
AD_GROUP_STAFF=Training-Staff

# TLS behaviour — set to true ONLY for local lab testing with a self-signed DC cert.
# MUST be false in production.
AD_TLS_REJECT_UNAUTHORIZED=false

# Connection timeout in milliseconds
AD_TIMEOUT_MS=10000

# ---------- Storage ----------
# Directory where uploaded slide files are stored (created automatically)
SLIDES_DIR=./uploads/slides
# LibreOffice executable used to convert uploaded PPTX files to PDF.
# Leave empty to auto-detect common install paths. Without it, PPTX uploads are rejected.
SOFFICE_PATH=
